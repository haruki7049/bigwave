cabal-version: 3.0
name: bigwave
version: 0.1.0.0
license: MIT
license-file: LICENSE
author: haruki7049
maintainer: tontonkirikiri@gmail.com
category: Sound
build-type: Simple

library
  exposed-modules: Bigwave
  build-depends:
    array,
    base,
    binary,
    bytestring,

  hs-source-dirs: lib
  default-language: Haskell2010

executable bigwave
  main-is: Main.hs
  build-depends:
    array,
    base,
    bigwave,

  hs-source-dirs: app
  default-language: Haskell2010

test-suite bigwave-test
  default-language: Haskell2010
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends:
    base,
    bigwave,
